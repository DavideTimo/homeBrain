@page "/telecamere"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Telecamere — Casa Timò</PageTitle>

<div class="d-flex align-items-center mb-4 gap-2">
    <h3 class="mb-0">Telecamere</h3>
    <span class="badge bg-secondary">Admin</span>
</div>

@if (_token is null)
{
    <div class="card border-0 shadow-sm" style="max-width:380px">
        <div class="card-body">
            <h6 class="card-title mb-3">Accesso amministratore</h6>
            <input class="form-control mb-2" @bind="_password" type="password"
                   placeholder="Password" @onkeydown="OnKeyDown" />
            <button class="btn btn-primary w-100" @onclick="Login" disabled="@_loading">
                @(_loading ? "Accesso…" : "Login")
            </button>
            @if (_loginError)
            {
                <div class="alert alert-danger mt-2 mb-0 py-2">Password errata.</div>
            }
        </div>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <span class="badge bg-success">● Autenticato</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Logout">Logout</button>
        <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="StartNewCamera">
            + Aggiungi telecamera
        </button>
    </div>

    @if (_cameras is null)
    {
        <div class="spinner-border spinner-border-sm text-secondary"></div>
    }
    else if (_cameras.Count == 0 && !_editing)
    {
        <div class="alert alert-info">
            Nessuna telecamera configurata. Clicca <strong>+ Aggiungi telecamera</strong> per iniziare
            (puoi configurarne quante ne monterai — fino a 5-6 nel piano attuale, ma non è un limite tecnico).
        </div>
    }

    <div class="row g-3">
        <!-- Lista telecamere -->
        <div class="col-12 col-md-4">
            <div class="list-group">
                @if (_cameras is not null)
                {
                    @foreach (var c in _cameras)
                    {
                        <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center
                                       @(_selectedId == c.Id ? "active" : "")"
                                @onclick="() => EditCamera(c)">
                            <span>
                                @(c.Location == "esterna" ? "🌳" : "🏠") @c.Name
                                @if (!c.Enabled)
                                {
                                    <small class="ms-1 @(_selectedId == c.Id ? "text-white-50" : "text-muted")">(disabilitata)</small>
                                }
                            </span>
                            <small class="@(_selectedId == c.Id ? "text-white-50" : "text-muted")">@c.Host</small>
                        </button>
                    }
                }
            </div>
        </div>

        <!-- Form aggiunta/modifica -->
        @if (_editing)
        {
            <div class="col-12 col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent d-flex align-items-center gap-2">
                        <span class="fw-semibold">@(_selectedId is null ? "Nuova telecamera" : $"Modifica: {_form.Name}")</span>
                        @if (_selectedId is not null)
                        {
                            <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="DeleteCurrent">
                                @(_confirmDelete ? "Confermi eliminazione?" : "🗑 Elimina")
                            </button>
                        }
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label small">Nome</label>
                                <input class="form-control" @bind="_form.Name" placeholder="es. ingresso" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small">Posizione</label>
                                <select class="form-select" @bind="_form.Location">
                                    <option value="interna">Interna</option>
                                    <option value="esterna">Esterna</option>
                                </select>
                            </div>
                            <div class="col-8">
                                <label class="form-label small">Host / IP</label>
                                <input class="form-control" @bind="_form.Host" placeholder="192.168.1.50" />
                            </div>
                            <div class="col-4">
                                <label class="form-label small">Porta RTSP</label>
                                <input class="form-control" type="number" @bind="_form.RtspPort" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small">Path RTSP (main, alta risoluzione)</label>
                                <input class="form-control" @bind="_form.RtspPath" placeholder="/h264Preview_01_main" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small">Path RTSP sub-stream (opzionale, per pipeline AI)</label>
                                <input class="form-control" @bind="_form.RtspSubPath" placeholder="/h264Preview_01_sub" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small">Utente</label>
                                <input class="form-control" @bind="_form.Username" autocomplete="off" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small">
                                    Password
                                    @if (_selectedId is not null && _form.HasExistingPassword)
                                    {
                                        <small class="text-muted">(lascia vuoto per non modificarla)</small>
                                    }
                                </label>
                                <input class="form-control" type="password" @bind="_form.Password" autocomplete="new-password" />
                            </div>
                            <div class="col-12 form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="enabledCheck" @bind="_form.Enabled" />
                                <label class="form-check-label" for="enabledCheck">Abilitata</label>
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <button class="btn btn-outline-secondary" @onclick="TestConnection" disabled="@_testing">
                                @(_testing ? "Test in corso…" : "📡 Testa connessione")
                            </button>
                            <button class="btn btn-success" @onclick="Save" disabled="@_saving">
                                @(_saving ? "Salvataggio…" : "💾 Salva")
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="CancelEdit">Annulla</button>
                        </div>

                        @if (_testResult is not null)
                        {
                            <div class="mt-3">
                                @if (_testResult.Success)
                                {
                                    <div class="alert alert-success py-2">
                                        ✅ Connessione riuscita (@_testResult.ElapsedMs ms)
                                    </div>
                                    @if (_testResult.PreviewBase64 is not null)
                                    {
                                        <img src="data:image/jpeg;base64,@_testResult.PreviewBase64"
                                             class="img-fluid rounded border" style="max-height:240px" />
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-danger py-2 mb-0">
                                        ❌ @_testResult.Error
                                    </div>
                                }
                            </div>
                        }

                        @if (_saveMessage is not null)
                        {
                            <div class="alert @(_saveError ? "alert-danger" : "alert-success") mt-2 mb-0 py-2">
                                @_saveMessage
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private const string ApiBase = "http://localhost:5233";

    private string _password = string.Empty;
    private string? _token;
    private bool _loading;
    private bool _loginError;

    private List<CameraDto>? _cameras;
    private string? _selectedId;
    private bool _editing;
    private CameraFormModel _form = new();
    private bool _confirmDelete;

    private bool _testing;
    private CameraTestResult? _testResult;

    private bool _saving;
    private string? _saveMessage;
    private bool _saveError;

    // ── Auth ────────────────────────────────────────────────────────────────
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Login();
    }

    private async Task Login()
    {
        _loading = true;
        _loginError = false;
        try
        {
            var resp = await Http.PostAsJsonAsync($"{ApiBase}/api/auth/token", new { Password = _password });
            if (!resp.IsSuccessStatusCode) { _loginError = true; return; }
            var result = await resp.Content.ReadFromJsonAsync<TokenResponse>();
            _token = result?.Token;
            await LoadCameras();
        }
        catch { _loginError = true; }
        finally { _loading = false; }
    }

    private void Logout()
    {
        _token = null;
        _password = string.Empty;
        _cameras = null;
        CancelEdit();
    }

    // ── Lista ───────────────────────────────────────────────────────────────
    private async Task LoadCameras()
    {
        try
        {
            _cameras = await Http.GetFromJsonAsync<List<CameraDto>>($"{ApiBase}/api/cameras");
        }
        catch { _cameras = new(); }
    }

    private void StartNewCamera()
    {
        _selectedId = null;
        _form = new CameraFormModel { Location = "esterna", RtspPort = 554, RtspPath = "/h264Preview_01_main", Enabled = true };
        _editing = true;
        _testResult = null;
        _saveMessage = null;
        _confirmDelete = false;
    }

    private void EditCamera(CameraDto c)
    {
        _selectedId = c.Id;
        _form = new CameraFormModel
        {
            Name = c.Name,
            Location = c.Location,
            Host = c.Host,
            RtspPort = c.RtspPort,
            RtspPath = c.RtspPath,
            RtspSubPath = c.RtspSubPath,
            Username = c.Username,
            Password = null,
            HasExistingPassword = c.HasPassword,
            Enabled = c.Enabled
        };
        _editing = true;
        _testResult = null;
        _saveMessage = null;
        _confirmDelete = false;
    }

    private void CancelEdit()
    {
        _editing = false;
        _selectedId = null;
        _testResult = null;
        _saveMessage = null;
        _confirmDelete = false;
    }

    // ── Test connessione ────────────────────────────────────────────────────
    private async Task TestConnection()
    {
        if (_token is null) return;
        _testing = true;
        _testResult = null;
        try
        {
            var req = new HttpRequestMessage(HttpMethod.Post, $"{ApiBase}/api/cameras/test");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", _token);
            req.Content = JsonContent.Create(new
            {
                Host = _form.Host,
                RtspPort = _form.RtspPort,
                RtspPath = _form.RtspPath,
                Username = _form.Username,
                Password = _form.Password
            });
            var resp = await Http.SendAsync(req);
            _testResult = await resp.Content.ReadFromJsonAsync<CameraTestResult>();
        }
        catch (Exception ex)
        {
            _testResult = new CameraTestResult(false, ex.Message, null, 0);
        }
        finally { _testing = false; }
    }

    // ── Salvataggio / eliminazione ──────────────────────────────────────────
    private async Task Save()
    {
        if (_token is null) return;
        _saving = true;
        _saveMessage = null;
        try
        {
            var body = new
            {
                Name = _form.Name,
                Location = _form.Location,
                Host = _form.Host,
                RtspPort = _form.RtspPort,
                RtspPath = _form.RtspPath,
                RtspSubPath = string.IsNullOrWhiteSpace(_form.RtspSubPath) ? null : _form.RtspSubPath,
                Username = string.IsNullOrWhiteSpace(_form.Username) ? null : _form.Username,
                Password = string.IsNullOrWhiteSpace(_form.Password) ? null : _form.Password,
                Enabled = _form.Enabled
            };

            var req = new HttpRequestMessage(
                _selectedId is null ? HttpMethod.Post : HttpMethod.Put,
                _selectedId is null ? $"{ApiBase}/api/cameras" : $"{ApiBase}/api/cameras/{_selectedId}");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", _token);
            req.Content = JsonContent.Create(body);

            var resp = await Http.SendAsync(req);
            _saveError = !resp.IsSuccessStatusCode;
            _saveMessage = resp.IsSuccessStatusCode ? "Salvato con successo." : $"Errore: {resp.StatusCode}";
            if (resp.IsSuccessStatusCode)
            {
                await LoadCameras();
                var saved = await resp.Content.ReadFromJsonAsync<CameraDto>();
                if (saved is not null) EditCamera(saved);
            }
        }
        catch (Exception ex) { _saveError = true; _saveMessage = ex.Message; }
        finally { _saving = false; }
    }

    private async Task DeleteCurrent()
    {
        if (_token is null || _selectedId is null) return;
        if (!_confirmDelete) { _confirmDelete = true; return; }

        try
        {
            var req = new HttpRequestMessage(HttpMethod.Delete, $"{ApiBase}/api/cameras/{_selectedId}");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", _token);
            var resp = await Http.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                await LoadCameras();
                CancelEdit();
            }
        }
        catch { }
    }

    // ── DTO/modelli ─────────────────────────────────────────────────────────
    private record TokenResponse(string Token);

    private class CameraDto
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Location { get; set; } = "interna";
        public string Host { get; set; } = "";
        public int RtspPort { get; set; } = 554;
        public string RtspPath { get; set; } = "";
        public string? RtspSubPath { get; set; }
        public string? Username { get; set; }
        public bool HasPassword { get; set; }
        public bool Enabled { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime UpdatedAt { get; set; }
    }

    private class CameraFormModel
    {
        public string Name { get; set; } = "";
        public string Location { get; set; } = "interna";
        public string Host { get; set; } = "";
        public int RtspPort { get; set; } = 554;
        public string RtspPath { get; set; } = "/h264Preview_01_main";
        public string? RtspSubPath { get; set; }
        public string? Username { get; set; }
        public string? Password { get; set; }
        public bool HasExistingPassword { get; set; }
        public bool Enabled { get; set; } = true;
    }

    private record CameraTestResult(bool Success, string? Error, string? PreviewBase64, long ElapsedMs);
}
