{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "CasaTimoDb": "Data Source=../../data/casatimo.db"
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "ClientId": "CasaTimoCamera",
    "UseTls": false
  },
  "Camera": {
    "ModelPath": "models/yolov8n.onnx",
    "NasBasePath": "/mnt/nas/casatimo/cameras",
    "RetentionDays": 14,
    "ConfThreshold": 0.4,
    "IouThreshold": 0.45,
    "MinMotionArea": 800,
    "TrackMissLimit": 15,
    "ReverifyEveryFrames": 10,
    "SnapshotIntervalSeconds": 0.5,
    "StatusPublishIntervalSeconds": 30
  }
}
